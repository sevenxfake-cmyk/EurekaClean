[Unit]
Description=ProyectoDante backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ProyectoDante
Environment=APP_HOST=127.0.0.1
Environment=APP_PORT=8000
Environment=APP_TRUST_PROXY=1
ExecStart=/usr/bin/python3 /var/www/ProyectoDante/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
